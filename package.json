{
  "name": "material-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n vite,wrangler \"vite\" \"wrangler pages dev --proxy 5173 --port 8787 --log-level warn\"",
    "build": "vite build",
    "deploy": "npm run build && wrangler pages deploy",
    "preview": "npm run build && wrangler pages dev dist/ --port 8788",
    "typecheck": "tsc --noEmit -p tsconfig.server.json",
    "typecheck:fe": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@arco-design/web-vue": "^2.58.0",
    "@highlightjs/vue-plugin": "^2.1.0",
    "@vue-office/docx": "^1.6.3",
    "highlight.js": "^11.11.1",
    "hono": "^4.9.4",
    "markdown-it": "^14.3.0",
    "marked": "^18.0.7",
    "pdfjs-dist": "^5.7.284",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@arco-plugins/vite-vue": "^1.4.6",
    "@cloudflare/workers-types": "^5",
    "@types/markdown-it": "^14.1.2",
    "@vitejs/plugin-vue": "^5.2.3",
    "concurrently": "^10.0.4",
    "typescript": "^5.8.3",
    "unplugin-auto-import": "^19.2.0",
    "unplugin-vue-components": "^28.7.0",
    "vite": "^6.3.5",
    "vue-tsc": "^2.2.8",
    "wrangler": "4.114.0"
  }
}
